{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
      "declaration": true,
      "emitDeclarationOnly": true,
      "outDir": "dist/types",
      "noEmit": false,
      "allowImportingTsExtensions": false,
      "declarationMap": true,
      "stripInternal": true,
      "skipLibCheck": true
    },
    "include": ["src"]
  }
  